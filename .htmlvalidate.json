{
  "root": true,
  "extends": ["html-validate:recommended"],
  "rules": {
    "doctype-style": [
      "error",
      {
        "style": "lowercase"
      }
    ],
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "tel-non-breaking": "error",
    "valid-id": [
      "error",
      {
        "relaxed": true
      }
    ],
    "void-style": "off"
  }
}